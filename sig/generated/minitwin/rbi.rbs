    def self?.literal_type: (untyped) -> String

    # : (untyped, untyped) -> String
    def self?.record_type: (untyped, untyped) -> String

    # : (untyped, untyped) -> String
    def self?.proc_from_function: (untyped, untyped) -> String

    # RBS positional parameters may be anonymous; Sorbet always needs a name.
    # : (untyped) -> Array[[String, untyped]]
    def self?.positional_pairs: (untyped) -> Array[[ String, untyped ]]

